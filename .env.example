# Copiar a .env.local y completar con los valores reales.
# .env.local esta en .gitignore: NUNCA commitear valores reales.

# --- Supabase ---
# Publicas: viajan al navegador, quedan limitadas por las politicas RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRETA: saltea RLS. Solo del lado del servidor (Route Handlers / Server
# Actions). Nunca con prefijo NEXT_PUBLIC_, nunca importada desde un
# componente con "use client".
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp ---
# Numero destino del link wa.me, en formato internacional y sin el "+".
# Ejemplo para Argentina: 5493884123456
NEXT_PUBLIC_WHATSAPP_NUMBER=
